<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns="UnityEngine.UIElements"
         editor-extension-mode="True">
    <Style src="project://database/Packages/io.github.ykysnk.utils/Editor/CustomDialogWindow.uss?fileID=7433441132597879392&amp;guid=bd5424873a997464a9921cedec83f4ed&amp;type=3#CustomDialogWindow"/>
    <ui:VisualElement class="dialog-root">
        <ui:VisualElement name="content" class="dialog-content"/>
        <ui:VisualElement class="dialog-footer">
            <ui:Button name="cancel" class="dialog-button dialog-button--secondary"/>
            <ui:Button name="ok" class="dialog-button dialog-button--primary"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
