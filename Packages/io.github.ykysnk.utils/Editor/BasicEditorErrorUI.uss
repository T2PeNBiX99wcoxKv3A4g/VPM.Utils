.error-root {
    flex-grow: 1;
    padding: 4px 2px 6px 2px;
}

.error-box {
    margin: 0 0 6px 0;
}

.error-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 2px 0;
    padding: 0 2px;
}

.error-badge {
    margin: 0;
    padding: 1px 8px;
    font-size: 11px;
    -unity-font-style: bold;
    background-color: rgba(128, 128, 128, 0.22);
    border-radius: 8px;
}

.error-copy {
    margin: 0;
    padding: 1px 10px;
    min-width: 54px;
    font-size: 11px;
    -unity-text-align: middle-center;
}

.error-foldout {
    margin: 0;
    padding: 0;
}

.error-details {
    white-space: normal;
    margin: 0;
    padding: 3px 5px;
    min-height: 44px;
    border-radius: 3px;
}
