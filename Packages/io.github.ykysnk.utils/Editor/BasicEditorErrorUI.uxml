<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="BasicEditorErrorUI.uss"/>
    <ui:VisualElement class="error-root">
        <ui:HelpBox text="Error" message-type="Error" name="errorBox" class="error-box"/>

        <ui:VisualElement class="error-header">
            <ui:Label text="Error details" class="error-title"/>
            <ui:Button text="Copy" name="copy" class="error-copy"
                       tooltip="Copy the error message and stack trace"/>
        </ui:VisualElement>

        <ui:TextField picking-mode="Ignore" value="" readonly="true" name="errorDetails" multiline="true"
                      class="error-details"/>
    </ui:VisualElement>
</ui:UXML>
